# Database (PostgreSQL)
DATABASE_URL="postgresql://smartpump_admin:smartpump_secure_password@localhost:5432/smartpump_db?schema=public"

# Redis
REDIS_URL="redis://:smartpump_redis_secret@localhost:6379"

# MQTT Broker — must match the broker the firmware connects to
# Using public EMQX broker (same as ESP32 firmware default)
MQTT_BROKER_URL="mqtt://broker.emqx.io:1883"
MQTT_TLS_BROKER_URL="mqtts://broker.emqx.io:8883"
MQTT_WS_BROKER_URL="ws://broker.emqx.io:8083/mqtt"

# MQTT Auth (leave blank for public broker, set for secured broker)
MQTT_USERNAME=""
MQTT_PASSWORD=""

# JWT Authentication
JWT_SECRET="smartpump_super_secret_jwt_key_at_least_32_bytes_long_production_ready!"

# Server Environment
NODE_ENV="production"
PORT=3000
