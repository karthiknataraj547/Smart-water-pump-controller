{
  "name": "smart-water-pump-controller-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Grade IoT Platform for Smart Water Pump Automation",
  "workspaces": [
    "packages/*",
    "backend/api",
    "apps/web"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=backend/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build:packages": "npm --workspace=packages/shared run build && npm --workspace=packages/validation run build && npm --workspace=packages/auth run build && npm --workspace=packages/mqtt run build && npm --workspace=packages/database run build",
    "db:generate": "npm --workspace=packages/database run generate",
    "db:migrate": "npm --workspace=packages/database run migrate",
    "db:seed": "npm --workspace=packages/database run seed",
    "lint": "npm run lint --workspaces",
    "test": "jest",
    "docker:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "eslint": "^9.16.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "effect": "^3.22.2",
    "next": "^15.5.26"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "deepmerge-ts": "^8.0.0"
  }
}
