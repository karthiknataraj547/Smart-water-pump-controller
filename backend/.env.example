# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_98374189374
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_872364
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration
# Options: 'sqlite' (zero-config local) or 'mysql' (production)
DB_TYPE=sqlite
DB_FILE=./data/water_pump.sqlite

# MySQL Configuration (Used if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=pump_admin
MYSQL_PASSWORD=pump_secure_password
MYSQL_DATABASE=smart_water_pump

# MQTT Broker Configuration
MQTT_PORT=1883
MQTT_WS_PORT=8883
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USER=iot_device
MQTT_PASSWORD=device_secure_token

# Automation & Safety Thresholds
DEFAULT_LOW_WATER_START_PCT=30
DEFAULT_HIGH_WATER_STOP_PCT=95
DEFAULT_MAX_RUNTIME_MINUTES=60
DEFAULT_DRY_RUN_TIMEOUT_SECONDS=120
